{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-link-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-13",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "link_hub",
      "migrations_dir": "./migrations"
    }
  ]
}
